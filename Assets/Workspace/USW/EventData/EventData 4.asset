  _eventTitle: "\uC774\uBCA4\uD2B8 \uD0C0\uC774\uD2C0"
  _eventDescription: "\"\uB3C4\uB9DD\uAC00\uB358 \uC624\uD1A0\uB9C8\uD1A4\uC774 \uB2F9\uC2E0\uC5D0\uAC8C
    \uBCF4\uD638\uB97C \uC694\uCCAD\uD569\uB2C8\uB2E4. \n\uADF8\uB97C \uB4A4\uCAD3\uB358
    \uB9C8\uBC95\uC0AC\uB294 \uC989\uC2DC \uC624\uD1A0\uB9C8\uD1A4\uC758 \uC2E0\uBCD1\uC744
    \uBD80\uD0C1\uD569\uB2C8\uB2E4.\n\u201C\uC800\uB294 \uADF8\uC800 \uC790\uC720\uB97C
    \uC5BB\uACE0 \uC2F6\uC744 \uBFD0\uC785\uB2C8\uB2E4.\u201D\n\"\uC800\uAC74 \uC704\uD5D8\uD55C
    \uBCD1\uAE30\uC785\uB2C8\uB2E4!\""
  _yesButtonText: "\uB204\uAD6C\uB4E0 \uC790\uC720\uB85C\uC6B8 \uAD8C\uB9AC\uAC00
    \uC788\uC2B5\uB2C8\uB2E4"
  _nvmButtonText: "\uC704\uD5D8\uD55C \uC874\uC7AC\uB294 \uAD00\uB9AC\uB418\uC5B4\uC57C
    \uD569\uB2C8\uB2E4"
  _energyCost: 10
  _successText: "\uC624\uD1A0\uB9C8\uD1A4\uC774 \uAC10\uC0AC\uC640 \uD568\uAED8 \uAC00\uC9C4
    \uBAA8\uB4E0\uAC78 \uAC74\uB0C5\uB2C8\uB2E4."
  _successReward:
    RewardType: 0
    Amount: 0
  _failureText: "\uBC29\uC2EC\uD55C \uD2C8\uC744 \uD0C0 \uC624\uD1A0\uB9C8\uD1A4\uC774
    \uB9C8\uBC95\uC0AC\uB97C \uC8FD\uC785\uB2C8\uB2E4!"
  _declinedText: "\uB9C8\uBC95\uC0AC\uAC00 \uC624\uD1A0\uB9C8\uD1A4\uC744 \uBD80\uC21C\uB4A4
    \uAE09\uD788 \uB5A0\uB0A9\uB2C8\uB2E4."
