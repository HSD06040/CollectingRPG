  m_Name: CommonData1 3
  m_EditorClassIdentifier: 
  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\uB9C8\uC744\uC758 \uC790\uACBD\uB2E8\uC774 \uB9C8\uC871
    \uD3EC\uB85C\uB4E4\uC744 \uC7A1\uC544 \uCC98\uD615\uD558\uB824 \uD569\uB2C8\uB2E4.\n\u201C\uC774\uB4E4\uC740
    \uC6B0\uB9AC \uACE0\uD5A5\uC744 \uC9D3\uBC1F\uC558\uC2B5\uB2C8\uB2E4! \uADF8\uB4E4\uB3C4
    \uADF8\uB9CC\uD55C \uB300\uAC00\uB97C \uCE58\uB7EC\uC57C \uD569\uB2C8\uB2E4!\u201D\n\uADF8\uB4E4\uC758
    \uB9D0\uC744 \uC5B8\uB73B \uB9DE\uAE30\uB3C4 \uD558\uBA74\uC11C\uB3C4 \uBB54\uAC00
    \uCC1C\uCC1C\uD558\uAE30\uB3C4 \uD569\uB2C8\uB2E4.\"\r\n"
  _yesButtonText: "\uB2F9\uC5F0\uD55C \uACB0\uACFC\uB2E4. "
  _nvmButtonText: "\uC6B0\uB9AC\uB294 \uADF8\uB4E4\uACFC \uB2E4\uB974\uB2E4. "
  _energyCost: 10
  _successText: "\uAC10\uC0AC\uB97C \uD45C\uD558\uBA70 \uC790\uACBD\uB2E8\uC774 \uB9C8\uC871\uC758
    \uC804\uB9AC\uD488\uC744 \uAC74\uB135\uB2C8\uB2E4."
  _failureText: "\uCC98\uD615\uB2F9\uD55C \uB9C8\uC871\uC5D0\uAC90 \uC5B4\uB5A0\uD55C
    \uBE7C\uC557\uC740 \uBB3C\uAC74\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4."
  _declinedText: "\uC790\uACBD\uB2E8\uC740 \uB2F9\uC2E0\uC744 \uACBD\uBA78\uD558\uBA70,
    \uB2F9\uC2E0 \uB9D0\uC744 \uBB34\uC2DC\uD569\uB2C8\uB2E4."
