  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\u201C\uB098\uB294 \uC655\uAD6D\uC758 \uADC0\uC871\uC774\uB2E4!
    \uB2F9\uC7A5 \uB0B4 \uB9C8\uCC28\uB97C \uAEBC\uB0B4\uB77C!\u201D\n\uC790\uC2E0\uC744
    \uC655\uAD6D\uC758 \uC720\uC77C\uD55C \uC0DD\uC874\uC790 \uADC0\uC871\uC774\uB77C
    \uC8FC\uC7A5\uD558\uB294 \uC774\uAC00 \uB2F9\uC2E0\uC5D0\uAC8C \uAD6C\uB369\uC774\uC5D0
    \uBE60\uC9C4 \uB9C8\uCC28\uB97C \uAEBC\uB0B4\uB77C\uACE0 \uBA85\uB839\uD569\uB2C8\uB2E4.\"\r"
  _yesButtonText: "\uC774 \uADC0\uC871\uC5D0\uAC8C \uACB8\uC190\uC744 \uAC00\uB974\uCCD0\uC900\uB2E4. "
  _nvmButtonText: "\uC655\uAD6D\uC744 \uBC84\uB9AC\uACE0 \uB3C4\uB9DD\uCE5C \uB188\uC5D0\uAC8C
    \uC904 \uB3C4\uC6C0\uC740 \uC5C6\uB2E4. "
  _energyCost: 10
  _successText: "\uB2F9\uC2E0\uC5D0\uAC8C \uC608\uC758 \uC8FC\uC785\uB41C \uADF8\uAC00
    \uC18C\uC815\uC758 \uC120\uBB3C\uC744 \uAC74\uB135\uB2C8\uB2E4."
  _failureText: "\uADF8\uB294 \uB2F9\uC2E0\uC758 \uC704\uD611\uC5D0 \uAF2C\uB9AC\uB97C
    \uB9D0\uACE0 \uB3C4\uB9DD\uCCE4\uC2B5\uB2C8\uB2E4."
  _declinedText: "\uADF8\uAC00 \uBD84\uB178\uC5B4\uB9B0 \uB208\uAE38\uB85C \uB5A0\uB098\uB294
    \uB2F9\uC2E0\uC744 \uBD05\uB2C8\uB2E4."
