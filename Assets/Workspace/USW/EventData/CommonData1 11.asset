  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\u201C\uC774\uACF3\uC740 \uC6CC\uB099 \uBCF5\uC7A1\uD55C
    \uACF3\uC778\uC9C0\uB77C \uC800 \uAC19\uC740 \uBC18\uB527\uBD88\uC774 \uAE38\uC7A1\uC774\uAC00
    \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4!\u201D\n\uB179\uC0C9 \uB79C\uD134\uC744
    \uB4E0 \uC0AC\uB0E5\uAFBC \uBCF5\uC7A5\uC758 \uB0A8\uC790\uAC00 \uAE38\uC7A1\uC774\uB97C
    \uC790\uCC98\uD558\uBA70 \uACE0\uC6A9\uC744 \uC81C\uC548\uD569\uB2C8\uB2E4. \n\uD55C
    \uBC88 \uACE0\uC6A9\uD560\uAE4C\uC694?\"\r"
  _yesButtonText: "\uC804\uBB38\uAC00\uAC00 \uC788\uB294 \uAC8C \uC88B\uC9C0. "
  _nvmButtonText: "\uC4F8\uB370\uC5C6\uB294 \uB3C8 \uB0AD\uBE44\uB294 \uC0AC\uC591\uC774\uC57C. "
  _energyCost: 10
  _successText: "\uD6CC\uB96D\uD55C \uAE38 \uC548\uB0B4 \uB355\uBD84\uC5D0 \uB9CE\uC740
    \uBB3C\uC790\uB97C \uC544\uAF08\uC2B5\uB2C8\uB2E4!"
  _failureText: "\uC5C9\uD130\uB9AC \uAE38 \uC548\uB0B4\uB85C \uACE0\uC0DD\uB9CC
    \uD588\uC2B5\uB2C8\uB2E4."
  _declinedText: "\uAC04\uC2E0\uD788 \uC9C0\uC5ED\uC744 \uB3CC\uD30C\uD588\uC2B5\uB2C8\uB2E4."
