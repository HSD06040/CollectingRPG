  m_Script: {fileID: 11500000, guid: 2f8b88d2f958cf14397dac7c5b800d44, type: 3}
  m_Name: EventData 3
  m_EditorClassIdentifier: 
  _eventTitle: "\uC9C0\uC5ED4"
  _eventDescription: "\"\uAD50\uB2E8\uC774 \uC0AC\uB78C\uB4E4\uC744 \uBD99\uC7A1\uC544
    \uCC98\uD615\uD558\uB824 \uD569\uB2C8\uB2E4. \n\u201C\uAD6C\uC6D0\uC790\uB2D8!
    \uC774\uB4E4\uC740 \uB9C8\uC871\uACFC \uACB0\uD0C1\uD558\uC5EC \uBC30\uC2E0\uD55C
    \uC790\uB4E4\uC785\uB2C8\uB2E4! \uADF8\uB7F0 \uC774\uB4E4\uC774 \uC2EC\uD310\uC744
    \uD53C\uD558\uBA74, \uADF8 \uB204\uAC00 \uC815\uC758\uB97C \uC704\uD574 \uC2F8\uC6B0\uACA0\uC2B5\uB2C8\uAE4C!\u201D"
  _yesButtonText: "\uADF8\uB4E4 \uC5ED\uC2DC \uC0B4\uAE30 \uC704\uD574 \uADF8\uB7AC\uC744
    \uBFD0\uC774\uB2E4"
  _nvmButtonText: "\uC815\uC758\uB294 \uBAA8\uB450\uC5D0\uAC8C \uACF5\uD3C9\uD574\uC57C
    \uD55C\uB2E4\t"
  _energyCost: 10
  _successText: "\uC6A9\uC11C\uBC1B\uC740 \uC774\uB4E4\uC774 \uD68C\uAC1C\uC758 \uC120\uBB3C\uC744
    \uAC74\uB0C5\uB2C8\uB2E4."
  _failureText: "\uC6A9\uC11C\uBC1B\uC740 \uC774\uB4E4\uC774 \uD55C\uBC24\uC911\uC5D0
    \uB3C4\uB9DD\uAC11\uB2C8\uB2E4."
  _declinedText: "\uC2EC\uBB38\uAD00\uC774 \uB2F9\uC2E0\uC5D0\uAC8C \uC874\uACBD\uC2EC\uC744
    \uD45C\uD569\uB2C8\uB2E4."
