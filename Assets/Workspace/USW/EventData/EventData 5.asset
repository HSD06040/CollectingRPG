  _eventTitle: "\uC9C0\uC5ED6"
  _eventDescription: "\"\uC7A5\uC758\uC0AC\uAC00 \uB110\uB9B0 \uC2DC\uCCB4\uB4E4\uC5D0\uAC8C\uC11C
    \uBB3C\uAC74\uC744 \uD6D4\uCE58\uACE0 \uBE48 \uC2DC\uCCB4\uB294 \uC218\uB808
    \uC704\uC5D0 \uC62C\uB824\uB461\uB2C8\uB2E4.\n\u201C\uC5F0\uACE0 \uC5C6\uB294
    \uC2DC\uC2E0\uC5D0\uAC8C \uC7A5\uB840\uB97C \uCE58\uB904\uC8FC\uB294\uB370, \uC774
    \uC815\uB3C4\uB294 \uAC00\uC838\uAC00\uB3C4 \uB418\uC9C0 \uC54A\uB098? \uB098
    \uC880 \uB3C4\uC640\uC904 \uC218 \uC788\uACA0\uB294\uAC00?\u201D\""
  _yesButtonText: "\uB9DD\uC790\uC758 \uAE38\uC744 \uAC00\uBCCD\uAC8C \uD574\uC900\uB2E4"
  _nvmButtonText: "\uB9DD\uC790\uB97C \uC695\uBCF4\uC774\uAE30 \uC2EB\uB2E4"
  _energyCost: 10
  _successText: "\uC7A5\uC758\uC0AC\uAC00 \uB2F9\uC2E0\uC758 \uBAAB\uC744 \uAC74\uB0C5\uB2C8\uB2E4."
  _failureText: "\uBD84\uB178\uD55C \uC6D0\uD63C\uC5D0\uAC8C\uC11C \uAC04\uC2E0\uD788
    \uB3C4\uB9DD\uCE69\uB2C8\uB2E4."
  _declinedText: "\uC6D0\uD63C\uB4E4\uC774 \uC7A5\uC758\uC0AC\uB9CC \uC8FD\uC778\uCC44
    \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
