  m_Script: {fileID: 11500000, guid: 2f8b88d2f958cf14397dac7c5b800d44, type: 3}
  m_Name: EventData 1
  m_EditorClassIdentifier: 
  _eventTitle: "\uC9C0\uC5ED2"
  _eventDescription: "\uD53C\uB09C\uBBFC\uB4E4\uC774 \uC6B8\uC74C\uC18C\uB9AC\uAC00
    \uBA54\uC544\uB9AC\uCE69\uB2C8\uB2E4.\n\n\uC8FC\uBCC0\uC5D0\uB294 \uD654\uC0B4\uC774
    \uBC15\uD78C \uC2DC\uCCB4\uB4E4\uC774 \uACF3\uACF3\uC5D0 \uB110\uBE0C\uB7EC\uC838
    \uC788\uC2B5\uB2C8\uB2E4.\n\n\u201C\uB204\uAD6C\uB4E0 \uC6B0\uB9AC \uC232\uC5D0
    \uCE68\uBC94\uD560 \uC218 \uC5C6\uB2E4.\u201D\n\n\uC774 \uC232\uC758 \uC21C\uCC30\uC790\uB4E4\uC740
    \uB9E4\uC6B0 \uB09C\uD3ED\uD55C \uBAA8\uC591\uC785\uB2C8\uB2E4.\n \n\uADF8\uB7EC\uB098
    \uD53C\uB09C\uBBFC\uB4E4\uC5D0\uAC8C \uC774 \uAE38 \uC678\uC5D0\uB294 \uB2E4\uB978
    \uC120\uD0DD\uC9C0\uAC00 \uC5C6\uC5B4 \uBCF4\uC785\uB2C8\uB2E4."
  _yesButtonText: "\uC21C\uCC30\uC790\uB4E4\uC744 \uC124\uB4DD\uD55C\uB2E4"
  _nvmButtonText: "\uADF8\uB4E4\uC758 \uC601\uC5ED\uC744 \uC874\uC911\uD55C\uB2E4"
  _energyCost: 10
  _successText: "\uD53C\uB09C\uBBFC\uB4E4\uC774 \uAC10\uC0AC\uC640 \uD568\uAED8 \uC120\uBB3C\uC744
    \uC90D\uB2C8\uB2E4"
  _successReward:
    RewardType: 0
    Amount: 0
  _failureText: "\uD53C\uB09C\uBBFC\uB4E4\uC740 \uAC00\uC9C4 \uAC83 \uC5C6\uC73C\uB098
    \uC9C4\uC2EC\uC744 \uB2E4\uD574 \uAC10\uC0AC\uD569\uB2C8\uB2E4"
  _declinedText: "\uC544\uBB34\uC77C \uC5C6\uC774 \uADF8\uB0E5 \uC9C0\uB098\uAC11\uB2C8\uB2E4"
