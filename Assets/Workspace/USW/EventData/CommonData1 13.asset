  m_Script: {fileID: 11500000, guid: 2f8b88d2f958cf14397dac7c5b800d44, type: 3}
  m_Name: CommonData1 13
  m_EditorClassIdentifier: 
  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\uB9C8\uC871\uB4E4\uC5D0\uAC8C\uC11C \uC5BB\uC740 \uB9C8\uBC95\uC11D\uB4E4\uC744
    \uBAB0\uB798 \uBC00\uBC18\uC785\uD558\uB294 \uC774\uB4E4\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4.\n\u201C\uC5B4\uCA54
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4! \uC774\uAC78\uB85C \uB9C8\uC871\uB4E4\uC744
    \uB9C9\uB294 \uB9C8\uBC95 \uBC29\uC5B4\uB9C9\uC744 \uB9CC\uB4E4 \uC218 \uC788\uB2E4\uACE0\uC694!\u201D\n\uADF8\uB4E4\uB3C4
    \uC0B4\uAE30 \uC704\uD574 \uD55C \uAC83\uC774\uC9C0\uB9CC, \uC790\uCE6B \uC798\uBABB\uD558\uBA74
    \uB9C8\uBC95\uC11D\uC774 \uC704\uD5D8\uD55C \uACF3\uC5D0 \uC4F0\uC77C \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\"\r"
  _yesButtonText: "\uC0B4\uC790\uACE0 \uD558\uB294 \uAC74\uB370 \uB108\uBB34\uD558\uC9C0
    \uC54A\uC740\uAC00. "
  _nvmButtonText: "\uC544\uBB34\uB9AC \uADF8\uB798\uB3C4 \uC704\uD5D8\uD55C \uC9D3\uC774\uB2E4. "
  _energyCost: 10
  _successText: "\uB2F9\uC2E0\uC758 \uC774\uD574\uC2EC\uC5D0 \uAC10\uC0AC\uD574\uD558\uBA70,
    \uAC70\uB798\uAE08 \uC77C\uBD80\uB97C \uAC74\uB135\uB2C8\uB2E4."
  _failureText: "\uC54C\uACE0 \uBCF4\uB2C8 \uB9C8\uC871\uC5D0\uAC8C \uB2E4\uC2DC
    \uBC00\uB9E4\uD558\uB294 \uC774\uB4E4\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
  _declinedText: "\uBC00\uB9E4\uC5C5\uC790\uB4E4\uC774 \uB2F9\uC2E0\uC744 \uB530\uB3CC\uB9AC\uBA70
    \uB3C4\uB9DD\uCCE4\uC2B5\uB2C8\uB2E4!"
