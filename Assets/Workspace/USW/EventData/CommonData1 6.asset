  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\u201C\uB2F9\uC2E0\uC758 \uC55E\uAE38\uC740 \uB9E4\uC6B0
    \uBC1D\uAD70\uC694.\u201D\n\uC810\uC7C1\uC774 \uBAA8\uD5D8\uAC00\uB77C\uB294
    \uAD34\uC0C1\uD55C \uC778\uBB3C\uC774 \uB2F9\uC2E0\uC5D0\uAC8C \uC88B\uC740 \uC778\uC5F0\uC774
    \uC788\uB294 \uC7A5\uC18C\uB97C \uC810\uC744 \uBD10\uC11C \uC54C\uB824\uC8FC\uACA0\uB2E4\uACE0
    \uD569\uB2C8\uB2E4. \uD55C \uBC88 \uD574\uBCFC\uAE4C\uC694?\"\r"
  _yesButtonText: "\uC810\uC744 \uBCF8\uB2E4. "
  _nvmButtonText: "\uBBF8\uC2E0\uC77C \uBFD0\uC774\uB2C8 \uBB34\uC2DC\uD55C\uB2E4. "
  _energyCost: 10
  _successText: "\uD589\uC6B4\uC758 \uC7A5\uC18C\uC5D0\uC11C \uBCF4\uBB3C\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
  _failureText: "\uD589\uC6B4\uC758 \uC7A5\uC18C\uC5D0 \uC654\uC9C0\uB9CC, \uC544\uBB34\uAC83\uB3C4
