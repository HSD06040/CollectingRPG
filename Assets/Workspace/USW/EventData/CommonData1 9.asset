  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\u201C\uC544, \uC774\uB7F0 \uC2DC\uB300\uC5D0\uB3C4 \uC5EC\uD589\uC790
    \uB3D9\uB8CC\uB77C \uADC0\uD558\uAD70! \uC5B4\uB5A4\uAC00? \uD55C\uC794\uD558\uACA0\uB294\uAC00?\u201D\n\uCE5C\uC808\uD55C
    \uC5EC\uD589\uAC1D\uB4E4\uC774 \uB2F9\uC2E0\uC5D0\uAC8C \uC220\uC744 \uAD8C\uD569\uB2C8\uB2E4.
    \uADF8\uB4E4\uACFC \uD55C\uBC88 \uC9C8\uD380\uD558\uAC8C \uB9C8\uC154\uBCFC\uAE4C\uC694?\"\r"
  _yesButtonText: "\uAC04\uB9CC\uC5D0 \uB9CC\uB09C \uC5EC\uD589\uC790\uB4E4\uC774\uB2E4.
    \uAC19\uC774 \uC990\uACA8\uBCF4\uC790. "
  _nvmButtonText: "\uC704\uD5D8\uD55C \uC2DC\uB300\uC5D0 \uC704\uD5D8\uD55C \uC9D3\uC774\uB2E4.
    \uCC38\uB294\uB2E4. "
  _energyCost: 10
  _successText: "\uC220\uC744 \uB9C8\uC2DC\uBA70 \uB2F9\uC2E0\uC740 \uBCF4\uBB3C
    \uC18C\uC2DD\uC744 \uB4E3\uC2B5\uB2C8\uB2E4."
  _failureText: "\uADF8\uB4E4\uC774 \uCDE8\uD55C \uB2F9\uC2E0\uC744 \uAE09\uC2B5\uD558\uB098,
    \uD328\uBC30\uD588\uC2B5\uB2C8\uB2E4."
  _declinedText: "\uB2F9\uC2E0\uC740 \uC720\uD639\uC744 \uC774\uACA8\uB0B4\uAE30
    \uC704\uD574 \uC544\uC608 \uB5A0\uB098\uBC84\uB9BD\uB2C8\uB2E4."
