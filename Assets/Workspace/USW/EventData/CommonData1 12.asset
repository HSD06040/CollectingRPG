  m_Script: {fileID: 11500000, guid: 2f8b88d2f958cf14397dac7c5b800d44, type: 3}
  m_Name: CommonData1 12
  m_EditorClassIdentifier: 
  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\uB9C8\uC871\uB4E4\uC758 \uB9C8\uBC95\uC11D \uC0AC\uC6A9\uC73C\uB85C
    \uC5B4\uCA4C\uB2E4 \uBD80\uD65C\uD55C \uC5B8\uB370\uB4DC\uB4E4\uC774 \uB09C\uB3D9\uC744
    \uBD80\uB9BD\uB2C8\uB2E4. \n\uADF8\uB4E4\uC740 \uC0AC\uC81C\uC758 \uC815\uC131\uC2A4\uB7EC\uC6B4
    \uCD95\uBCF5\uACFC \uC7A5\uB840 \uC808\uCC28\uB85C \uB2E4\uC2DC \uBB3B\uD788\uAE38
    \uC6D0\uD569\uB2C8\uB2E4.\"\r"
  _yesButtonText: "\uB9C8\uC9C0\uB9C9 \uAC00\uB294 \uAE38 \uB2F9\uC5F0\uD55C \uC694\uAD6C\uB2E4. "
  _nvmButtonText: "\uC774\uBBF8 \uC8FD\uC740 \uAC83\uB4E4\uC774 \uBC30\uAC00 \uBD88\uB800\uB124. "
  _energyCost: 10
  _successText: "\uC815\uC131\uC5D0 \uAC10\uC0AC\uD574\uD558\uBA70, \uC790\uC2E0\uB4E4\uC758
    \uC720\uD488\uC744 \uC120\uBB3C\uD569\uB2C8\uB2E4."
  _failureText: "\uC5F0\uACE0 \uC5C6\uB294 \uC774\uB4E4\uC778\uC9C0\uB77C, \uAC10\uC0AC\uD568\uB9CC\uC744
    \uD45C\uD558\uBA70 \uB5A0\uB0A9\uB2C8\uB2E4."
  _declinedText: "\uC7A5\uC758\uC0AC\uAC00 \uB2F9\uC2E0\uC758 \uBC1C\uC5B8\uC5D0
    \uBD84\uB178\uD574 \uB2F9\uC2E0\uC744 \uCAD3\uC544\uB0C5\uB2C8\uB2E4."
