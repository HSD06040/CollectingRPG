  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\uC61B\uB0A0 \uBA78\uB9DD\uD588\uB2E4\uB294 \uACE0\uB300\uC778\uB4E4\uC774
    \uB0A8\uAE34 \uC800\uC8FC\uBC1B\uC740 \uC720\uC801\uC785\uB2C8\uB2E4. \n\uADFC\uCC98\uC758
    \uC774\uB4E4\uC740 \uC774\uACF3\uC774 \uC800\uC8FC\uBC1B\uC558\uB2E4\uACE0 \uC0DD\uAC01\uD574
    \uADFC\uCC98\uB3C4 \uAC00\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \n\uD558\uC9C0\uB9CC
    \uADF8\uB7F0 \uACF3\uC5D4 \uC73C\uB808 \uBCF4\uBB3C\uC774 \uC788\uB294 \uBC95.
    \uC6A9\uAE30\uB97C \uB0B4\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\"\r"
  _yesButtonText: "\uC6A9\uAE30\uB97C \uB0B4\uBCF4\uC790! "
  _nvmButtonText: "\uC544\uBB34\uB3C4 \uC548 \uB4E4\uC5B4\uAC00\uB294 \uAC74 \uC774\uC720\uAC00
    \uC788\uB2E4. "
  _energyCost: 10
  _successText: "\uACE0\uB300\uC778\uB4E4\uC774 \uB0A8\uAE34 \uBCF4\uBB3C\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
  _failureText: "\uB178\uB825\uC5D0\uB3C4 \uBD88\uAD6C\uD558\uACE0 \uB0A8\uC740 \uAC8C
    \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
  _declinedText: "\uB2F9\uC2E0\uC740 \uADFC\uCC98\uC870\uCC28 \uAC00\uC9C0 \uC54A\uACE0
    \uC544\uC608 \uB5A0\uB0A9\uB2C8\uB2E4."
