  m_Name: EventData 2
  m_EditorClassIdentifier: 
  _eventTitle: "\uC774\uBCA4\uD2B8 \uD0C0\uC774\uD2C0"
  _eventDescription: "\uC655\uAD6D\uC740 \uBD80\uD65C\uD588\uC9C0\uB9CC, \uC5EC\uC804\uD788
    \uBAA8\uB4E0 \uC790\uC6D0\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4.\n\n\uC655\uAD6D
    \uACBD\uBE44\uB300\uC6D0\uB4E4\uC774 \uC2DC\uBBFC\uB4E4\uC758 \uBB3C\uC790\uB97C
    \uAC15\uC81C\uB85C \uC9D5\uBC1C\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \n\n\u201C\uC5B4\uCA54
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uACBD\uBE44\uB300\uAC00 \uAD76\uC73C\uBA74
    \uC5B4\uCC0C \uC655\uAD6D\uC744 \uBC29\uC5B4\uD55C\uB2E8 \uB9D0\uC500\uC785\uB2C8\uAE4C?\u201D"
  _yesButtonText: "\uC5B4\uCA54 \uC218 \uC5C6\uC774 \uD5C8\uB77D\uD55C\uB2E4"
  _nvmButtonText: "\uC9D5\uBC1C\uC744 \uAE08\uC9C0\uD55C\uB2E4"
  _energyCost: 10
  _successText: "\uC77C\uD589\uC5D0\uAC8C\uB3C4 \uBCF4\uAE09\uD488\uC774 \uBD84\uBC30\uB429\uB2C8\uB2E4"
  _successReward:
    RewardType: 0
    Amount: 0
  _failureText: "\uBD88\uD589\uD788\uB3C4 \uB0A8\uC740 \uBCF4\uAE08\uD488\uC774 \uC5C6\uC2B5\uB2C8\uB2E4"
  _declinedText: "\uACBD\uBE44\uB300\uAC00 \uBCF4\uAE09\uD488 \uBD80\uC871\uC5D0
    \uD5C8\uB355\uC785\uB2C8\uB2E4"
