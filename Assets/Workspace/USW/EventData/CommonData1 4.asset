  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\u201C\uC804 \uC138\uC0C1\uC744 \uB3CC\uC544\uB2E4\uB2C8\uBA70
    \uBCF4\uB2E4 \uB354 \uB300\uC911\uC801\uC778 \uCE58\uB8CC\uB97C \uBC1B\uC744
    \uC218 \uC788\uB294 \uBC29\uBC95\uC744 \uCC3E\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\u201D\n\uADF8
    \uC758\uB3C4\uB294 \uC88B\uC544 \uBCF4\uC774\uC9C0\uB9CC, \uC815\uB9D0\uB85C
    \uC88B\uC740 \uC758\uC0AC\uAC00 \uB9DE\uC744\uAE4C? \n\uADF8\uB294 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C
    \uC790\uC2E0\uC774 \uB9CC\uB4E0 \uC57D\uC73C\uB85C \uCE58\uB8CC\uD558\uACA0\uB2E4\uACE0
    \uD569\uB2C8\uB2E4. \uD5C8\uB77D\uD560\uAE4C\uC694?\"\r"
  _yesButtonText: "\uADF8\uC758 \uCE58\uB8CC\uB97C \uBBFF\uC5B4\uBCF8\uB2E4. "
  _nvmButtonText: "\uB108\uBB34 \uC218\uC0C1\uD55C \uC0AC\uB78C\uC774\uB2E4. "
  _energyCost: 10
  _successText: "\uCE58\uB8CC\uB294 \uB300\uC131\uACF5\uC785\uB2C8\uB2E4."
  _failureText: "\uCE58\uB8CC\uAC00 \uC2E4\uD328\uD588\uACE0, \uB9CE\uC740 \uC774\uB4E4\uC774
    \uD6C4\uC720\uC99D\uC5D0 \uC8FD\uC5C8\uC2B5\uB2C8\uB2E4."
  _declinedText: "\uADF8\uAC00 \uB2F9\uC2E0 \uBAB0\uB798 \uC0AC\uB78C\uC744 \uCE58\uB8CC\uD558\uB2E4
    \uC8FD\uC600\uC2B5\uB2C8\uB2E4."
