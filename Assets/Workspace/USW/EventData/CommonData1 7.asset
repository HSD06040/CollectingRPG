  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\u201C\uB9C8\uC871\uC774\uC57C! \uC8FD\uC5EC!\u201D\n\uD640\uB85C
    \uC0B4\uC544\uAC00\uB358 \uB9C8\uC871\uC774 \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C
    \uB458\uB7EC\uC2F8\uC5EC \uC8FD\uAC8C \uC0DD\uACBC\uC2B5\uB2C8\uB2E4.\n\uACFC\uC5F0
    \uB9C8\uC871 \uC911\uC5D4 \uC120\uB7C9\uD55C \uC774\uAC00 \uC5C6\uC744\uAE4C\uC694?
    \uACFC\uC5F0 \uADF8\uB294 \uC5B4\uB5A8\uAE4C\uC694? \uAD6C\uD560\uAE4C\uC694?\"\r"
  _yesButtonText: "\uC774\uAC74 \uC633\uC9C0 \uC54A\uC740 \uC77C\uC774\uB2E4. \uB9C8\uC871\uC744
    \uAD6C\uD55C\uB2E4. "
  _nvmButtonText: "\uB9C8\uC871\uC740 \uBBFF\uC9C0 \uBABB\uD560 \uC885\uC790\uB4E4\uC774\uB2E4. "
  _energyCost: 10
  _successText: "\uAD6C\uC6D0\uBC1B\uC740 \uB9C8\uC871\uC774 \uC790\uC2E0\uC758 \uBCF4\uBB3C\uC744
    \uC120\uBB3C\uD569\uB2C8\uB2E4."
  _failureText: "\uB9C8\uC871\uC740 \uB9C8\uC744\uC758 \uC6B0\uBB3C\uC5D0 \uB3C5\uC744
    \uD480\uACE0 \uB3C4\uB9DD\uCCE4\uC2B5\uB2C8\uB2E4."
  _declinedText: "\uB2F9\uC2E0\uC740 \uC544\uBB34 \uAC04\uC12D \uC5C6\uC774 \uADF8\uB0E5
    \uB5A0\uB0AC\uC2B5\uB2C8\uB2E4."
