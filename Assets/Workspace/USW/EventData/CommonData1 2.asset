  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\uD53C\uB09C\uBBFC \uCD9C\uC2E0\uC758 \uB3C4\uC801 \uB5BC\uAC00
    \uD53C\uB09C\uBBFC\uC744 \uD138\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC740
    \uADF8\uB4E4\uC744 \uC751\uC9D5\uD588\uC73C\uB098, \uADF8\uB4E4\uC740 \uADF8\uC800
    \uB208\uBB3C\uB9CC \uD758\uB9BD\uB2C8\uB2E4.\n\u201C\uC6B0\uB9AC\uB3C4 \uBA39\uACE0
    \uC0B4\uB824\uBA74 \uC5B4\uCA54 \uC218\uAC00 \uC5C6\uC5C8\uB2E4\uACE0\uC694.\u201D\"\r\n\r\n\r\n"
  _yesButtonText: "\uC774\uBC88\uC740 \uC6A9\uC11C\uD560 \uD14C\uB2C8 \uBE7C\uC557\uC740
    \uAC78 \uB3CC\uB824\uC918\uB77C. "
  _nvmButtonText: "\uBC94\uC8C4\uB294 \uBC94\uC8C4\uB2E4. \uC2EC\uD310\uC744 \uBC1B\uC73C\uB77C. "
  _energyCost: 10
  _successText: "\uBB3C\uAC74\uC744 \uB3CC\uB824\uBC1B\uC740 \uD53C\uB09C\uBBFC\uB4E4\uC774
    \uAC10\uC0AC\uC758 \uD45C\uC2DC\uB97C \uD569\uB2C8\uB2E4."
  _failureText: "\uD53C\uB09C\uBBFC\uB4E4\uC774 \uB2F9\uC2E0\uC5D0\uAC8C \uAC10\uC0AC\uB97C
    \uD45C\uD558\uBA70 \uB5A0\uB0A9\uB2C8\uB2E4."
  _declinedText: "\uC774\uBBF8 \uADF8\uB4E4\uC758 \uBB3C\uAC74 \uB300\uB2E4\uC218\uAC00
    \uD30C\uC190\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
