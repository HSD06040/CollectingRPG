  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\u201C\uC5B4\uB5A4\uAC00? \uD589\uC6B4\uC758 \uC2E0\uAED8
    \uD55C \uBC88 \uC6B4\uBA85\uC744 \uB9E1\uACA8\uBCF4\uACA0\uB098?\u201D\n\uC138\uC0C1\uC774
    \uC5B4\uC9C0\uB7EC\uC6B8\uC218\uB85D \uD55C\uD0D5\uC8FC\uC758\uB294 \uCEE4\uC9C0\uB294
    \uBC95\uC785\uB2C8\uB2E4. \uD3C9\uC18C\uC5D4 \uBD88\uBC95\uC774\uC5C8\uB358 \uB3C4\uBC15\uC7A5\uC774
    \uC5F4\uB838\uC2B5\uB2C8\uB2E4. \uC5B4\uCC0C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\"\r"
  _yesButtonText: "\uD589\uC6B4\uC758 \uC2E0\uC5D0\uAC8C \uC6B4\uBA85\uC744 \uB9E1\uACA8\uBCF8\uB2E4. "
  _nvmButtonText: "\uB3C4\uBC15\uC740 \uBC94\uC8C4\uB2E4. \uADF8\uB4E4\uC744 \uB2E8\uC18D\uD55C\uB2E4. "
  _energyCost: 10
  _successText: "\uD589\uC6B4\uC774 \uB530\uB77C \uD55C\uBAAB \uB2E8\uB2E8\uD788
    \uC7A1\uC558\uC2B5\uB2C8\uB2E4."
  _failureText: "\uBD88\uD589\uC774 \uCC3E\uC544\uC654\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC740
    \uBE48\uD138\uD130\uB9AC\uC785\uB2C8\uB2E4."
  _declinedText: "\uB3C4\uBC15\uC7A5 \uC778\uC6D0\uC774 \uBA54\uB69C\uAE30\uB5BC\uCC98\uB7FC
    \uD769\uC5B4\uC838 \uB3C4\uB9DD\uCCE4\uC2B5\uB2C8\uB2E4!"
