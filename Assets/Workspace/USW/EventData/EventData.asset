  m_Name: EventData
  m_EditorClassIdentifier: 
  _eventTitle: "\uC9C0\uC5ED1"
  _eventDescription: "\n\u201C\uC774\uBD10 \uD615\uC528. \uC774\uACF3\uC740 \uC6B0\uB9AC
    \uAD6C\uC5ED\uC774\uC57C. \uBB50, \uAC19\uC774 \uD138 \uC0DD\uAC01\uC774\uBA74\n\uD2B9\uBCC4\uD788
    \uB098\uB220\uC904 \uC218 \uC788\uC9C0.\u201D\n\n\uB9C8\uC655\uAD70\uC5D0\uAC8C
    \uC57D\uD0C8\uB2F9\uD558\uACE0 \n\uD3D0\uD5C8\uAC00 \uB41C \uB9C8\uC744...\n\uD558\uC9C0\uB9CC
    \uADF8 \uC794\uD574\uB9C8\uC800 \uD0D0\uB0B4\uB294 \uD558\uC774\uC5D0\uB098\uB4E4\uC774
    \uC874\uC7AC\uD569\uB2C8\uB2E4. \n\n\uADF8\uB4E4\uC744 \uD1A0\uBC8C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  _yesButtonText: "\uB3C4\uC801\uB4E4\uC744 \uCC98\uB2E8\uD55C\uB2E4"
  _nvmButtonText: "\uB3C4\uC801\uB4E4\uACFC \uAC19\uC774 \uB9C8\uC744\uC744 \uC57D\uD0C8\uD55C\uB2E4"
  _energyCost: 10
  _successText: "\uB3C4\uC801\uB4E4\uC774 \uC804\uB9AC\uD488\uC744 \uC5BB\uC5C8\uC2B5\uB2C8\uB2E4."
  _successReward:
    RewardType: 0
    Amount: 0
  _failureText: "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC758 \uAC10\uC0AC\uB97C \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
  _declinedText: "\uB3C4\uC801\uB4E4\uC774 \uC57D\uD0C8\uD488\uC744 \uAC00\uC9C0\uACE0
    \uB3C4\uC8FC\uD588\uC2B5\uB2C8\uB2E4."
