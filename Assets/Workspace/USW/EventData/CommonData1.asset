  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\uC815\uCC30\uB300\uB85C \uBCF4\uC774\uB294 \uC18C\uC218\uC758
    \uB9C8\uC871\uC774 \uC21C\uCC30\uC744 \uB3CC\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
    \uC57D\uD0C8\uC744 \uBC8C\uC774\uAE30\uB77C\uB3C4 \uD55C \uAC74\uC9C0, \uADF8\uB4E4\uC758
    \uC8FC\uBA38\uB2C8\uB294 \uB450\uB451\uD574 \uBCF4\uC785\uB2C8\uB2E4. \uD558\uC9C0\uB9CC
    \uADF8\uB4E4\uC740 \uC870\uAE08\uC774\uB77C\uB3C4 \uC218\uC0C1\uD55C \uB08C\uC0C8\uAC00
    \uBCF4\uC774\uBA74 \uB3C4\uB9DD\uCE60 \uC0DD\uAC01\uC73C\uB85C \uBCF4\uC785\uB2C8\uB2E4.\r"
  _yesButtonText: "\uC740\uBC00\uD788 \uB2E4\uAC00\uAC00 \uC815\uCC30\uB300\uB97C
    \uC2B5\uACA9\uD55C\uB2E4."
  _nvmButtonText: "\uAD73\uC774 \uC2F8\uC6B8 \uD544\uC694\uAC00 \uC5C6\uB2E4. \uD53C\uD574
    \uAC04\uB2E4."
  _energyCost: 10
  _successText: "\uC815\uCC30\uB300\uB97C \uC7A1\uACE0 \uC804\uB9AC\uD488\uC744 \uC5BB\uC5C8\uC2B5\uB2C8\uB2E4."
  _failureText: "\uC815\uCC30\uB300\uB97C \uC7A1\uC558\uC73C\uB098 \uC4F8\uB9CC\uD55C
    \uBB3C\uAC74\uC774 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
  _declinedText: "\uC815\uCC30\uB300\uB97C \uC131\uACF5\uC801\uC73C\uB85C \uD53C\uD574
    \uAC14\uC2B5\uB2C8\uB2E4."
