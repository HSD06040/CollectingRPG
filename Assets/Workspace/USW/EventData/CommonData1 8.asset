  _eventTitle: "\uACF5\uC6A9\uC774\uBCA4\uD2B8"
  _eventDescription: "\"\uAC04\uB9CC\uC5D0 \uC120\uC220\uC9D1\uC5D0\uC11C \uC990\uAC70\uC6B4
    \uC2DC\uAC04\uC744 \uBCF4\uB0C5\uB2C8\uB2E4. \uAC70\uAE30\uC11C \uC990\uAC70\uC6B4
    \uCE74\uB4DC \uAC8C\uC784\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4. \uAC8C\uC784\uC740
    \uB9C9\uBC14\uC9C0\uC5D0 \uB2E4\uB2E4\uB974\uACE0, \uB9C8\uC9C0\uB9C9 \uC120\uD0DD\uC774
    \uB0A8\uC558\uC2B5\uB2C8\uB2E4!\n\uC624\uB978\uCABD, \uC67C\uCABD \uC5B4\uB514\uB85C
    \uD560\uAE4C\uC694?\"\r"
  _yesButtonText: "\uC624\uB978\uCABD"
  _nvmButtonText: "\uC67C\uCABD"
  _energyCost: 10
  _successText: "\uAC8C\uC784\uC5D0\uC11C \uC2B9\uB9AC\uD558\uACE0 \uD310\uB3C8\uC744
